generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum PlayerStatus {
  ONLINE
  OFFLINE
  IN_COMBAT
  IN_MISSION
  BANNED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  DEPOSIT_EURO
  PURCHASE_VIDACOINS
  MARKET_BUY
  MARKET_SELL
  CLAN_DONATION
  BATTLE_PASS_REWARD
  SALARY
  FINE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ItemType {
  WEAPON
  VEHICLE
  HOUSE
  SKIN
  BOOSTER
  CONSUMABLE
  SPECIAL
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  username  String    @unique
  role      UserRole  @default(PLAYER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?
  player    Player?
  payments  Payment[]

  @@index([email])
  @@index([username])
}

model Player {
  id              String              @id @default(cuid())
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id])
  level           Int                 @default(1)
  experience      Int                 @default(0)
  money           Float               @default(1000.0)
  vidacoins       Int                 @default(0)
  status          PlayerStatus        @default(OFFLINE)
  currentCity     String              @default("Madrid")
  health          Int                 @default(100)
  maxHealth       Int                 @default(100)
  stamina         Int                 @default(100)
  maxStamina      Int                 @default(100)
  strength        Int                 @default(10)
  agility         Int                 @default(10)
  intelligence    Int                 @default(10)
  charisma        Int                 @default(10)
  reputation      Int                 @default(0)
  respect         Int                 @default(0)
  wantedLevel     Int                 @default(0)
  clanId          String?
  clanRole        String?
  battlePassLevel Int                 @default(1)
  battlePassXp    Int                 @default(0)
  hasPremiumBP    Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  inventory       InventoryItem[]
  vehicles        PlayerVehicle[]
  properties      PlayerProperty[]
  weapons         PlayerWeapon[]
  missions        MissionProgress[]
  achievements    PlayerAchievement[]
  skills          PlayerSkill[]
  transactions    Transaction[]
  ledClans        Clan[]              @relation("LeaderOfClan")
  clanMemberships Clan[]              @relation("MemberOfClan")
  clansLed        Clan[]              @relation("ClanLeaderRel")

  @@index([userId])
  @@index([currentCity])
}

model PaymentPackage {
  id            String    @id @default(cuid())
  name          String
  description   String?
  vidacoins     Int
  priceCents    Int
  currency      String    @default("EUR")
  stripePriceId String?
  isActive      Boolean   @default(true)
  bonusPercent  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]

  @@index([isActive])
}

model Payment {
  id                    String          @id @default(cuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id])
  packageId             String?
  package               PaymentPackage? @relation(fields: [packageId], references: [id])
  amount                Float
  currency              String          @default("EUR")
  vidacoinsAwarded      Int
  stripeSessionId       String          @unique
  stripePaymentIntentId String?         @unique
  status                PaymentStatus   @default(PENDING)
  metadata              Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([userId])
  @@index([stripeSessionId])
  @@index([status])
}

model Transaction {
  id          String            @id @default(cuid())
  playerId    String
  player      Player            @relation(fields: [playerId], references: [id])
  amount      Float
  currency    String            @default("EUR")
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([playerId])
  @@index([status])
  @@index([type])
}

model GameItem {
  id            String          @id @default(cuid())
  name          String
  description   String?
  type          ItemType
  rarity        Rarity          @default(COMMON)
  stats         Json?
  price         Float
  vidacoinPrice Int?
  isTradable    Boolean         @default(true)
  isStackable   Boolean         @default(false)
  maxStack      Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  instances     InventoryItem[]

  @@index([type])
  @@index([rarity])
}

model InventoryItem {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id])
  itemId      String
  item        GameItem @relation(fields: [itemId], references: [id])
  quantity    Int      @default(1)
  isEquipped  Boolean  @default(false)
  customStats Json?
  acquiredAt  DateTime @default(now())

  @@unique([playerId, itemId])
  @@index([playerId])
  @@index([itemId])
}

model PlayerVehicle {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id])
  vehicleId    String
  licensePlate String   @unique
  color        String   @default("Negro")
  upgrades     Json?
  condition    Int      @default(100)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([playerId])
}

model PlayerProperty {
  id            String   @id @default(cuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id])
  propertyId    String
  purchasePrice Float
  purchasedAt   DateTime @default(now())
  isPrimary     Boolean  @default(false)
  rentIncome    Float    @default(0)

  @@index([playerId])
}

model PlayerWeapon {
  id         String  @id @default(cuid())
  playerId   String
  player     Player  @relation(fields: [playerId], references: [id])
  weaponId   String
  ammo       Int     @default(0)
  wear       Int     @default(100)
  skin       String?
  isFavorite Boolean @default(false)

  @@index([playerId])
}

model Territory {
  id          String   @id @default(cuid())
  name        String   @unique
  city        String
  description String?
  clanId      String?
  clan        Clan?    @relation("TerritoryClan", fields: [clanId], references: [id])
  influence   Int      @default(0)
  baseIncome  Float    @default(100)
  taxRate     Float    @default(0.05)
  coordinates Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([clanId])
}

model Clan {
  id          String      @id @default(cuid())
  name        String      @unique
  tag         String      @unique
  description String?
  leaderId    String      @unique
  leader      Player      @relation("ClanLeaderRel", fields: [leaderId], references: [id])
  treasury    Float       @default(0)
  vidacoins   Int         @default(0)
  level       Int         @default(1)
  experience  Int         @default(0)
  memberCount Int         @default(1)
  maxMembers  Int         @default(20)
  territories Territory[] @relation("TerritoryClan")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  members     Player[]    @relation("MemberOfClan")
  ledBy       Player[]    @relation("LeaderOfClan")

  @@index([name])
  @@index([tag])
}

model Mission {
  id           String            @id @default(cuid())
  name         String
  description  String
  type         String
  requirements Json?
  rewards      Json
  difficulty   String            @default("medium")
  timeLimit    Int?
  isActive     Boolean           @default(true)
  isRepeatable Boolean           @default(false)
  createdAt    DateTime          @default(now())
  progress     MissionProgress[]

  @@index([type])
  @@index([isActive])
}

model MissionProgress {
  id          String    @id @default(cuid())
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id])
  missionId   String
  mission     Mission   @relation(fields: [missionId], references: [id])
  status      String    @default("active")
  progress    Int       @default(0)
  target      Int       @default(1)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([playerId, missionId])
  @@index([playerId])
  @@index([status])
}

model Skill {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String
  category     String
  maxLevel     Int           @default(10)
  effects      Json
  createdAt    DateTime      @default(now())
  playerSkills PlayerSkill[]

  @@index([category])
}

model PlayerSkill {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id])
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id])
  level      Int      @default(1)
  xp         Int      @default(0)
  unlockedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([playerId, skillId])
  @@index([playerId])
}

model Achievement {
  id                 String              @id @default(cuid())
  name               String              @unique
  description        String
  category           String
  requirements       Json
  reward             Json
  isSecret           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  playerAchievements PlayerAchievement[]

  @@index([category])
}

model PlayerAchievement {
  id            String      @id @default(cuid())
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@unique([playerId, achievementId])
  @@index([playerId])
}

model GameConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Ban {
  id        String    @id @default(cuid())
  userId    String
  reason    String
  duration  Int?
  issuedBy  String
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId])
}
