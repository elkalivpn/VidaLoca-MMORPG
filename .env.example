# Database (PostgreSQL)
DATABASE_URL="postgresql://vidaloca:vidaloca@localhost:5432/vidaloca?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development

# Redis (optional, for future rate-limit / sessions)
REDIS_URL="redis://localhost:6379"

# Client CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"
